/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3588-orangepi-5-compact.dtsi"

/ {
	model = "Xunlong Orange Pi 5 Max";
	compatible = "xunlong,orangepi-5-max", "rockchip,rk3588";

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_LOW>;
	};

	/*
	 * wireless-bluetooth (bluetooth-platdata): used only by rfkill_bt.
	 * rfkill_bt finds this node by compatible and creates a platform device from it
	 * (it does not respect status="disabled"), then uses bt-reset-gpio, bt-wake-gpio,
	 * bt-wake-host-gpio for rfkill block/unblock and bluesleep.
	 * No uart-rts-gpio / rts_gpio here: RTS is owned by &uart7 (uart7m0_rtsn on GPIO4 PC2).
	 *
	 * Actual BT transport and power sequencing are under &uart7 { bluetooth { } }
	 * (brcm,bcm4345c5), which hci_uart_bcm uses (device-wakeup-gpios, shutdown-gpios).
	 * Same pins, different property names for the two drivers.
	 */
	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		bt-reset-gpio = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		bt-wake-gpio = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
		bt-wake-host-gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_reset_gpio &bt_wake_gpio &bt_irq_gpio>;
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		status = "disabled";
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "ap6611";
		wifi-host-wake-gpio = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		wifi-poweren-gpio = <&gpio2 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		status = "okay";
	};

	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	hdmi0-sound {
		status = "okay";
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <0x80>;
		rockchip,card-name = "rockchip-hdmi0";
		rockchip,cpu = <&i2s5_8ch>;
		rockchip,codec = <&hdmi0>;
		rockchip,jack-det;
	};

	hdmi1-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi1_con_in: endpoint {
				remote-endpoint = <&hdmi1_out_con>;
			};
		};
	};

	hdmi1-sound {
		status = "okay";
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <0x80>;
		rockchip,card-name = "rockchip-hdmi1";
		rockchip,cpu = <&i2s6_8ch>;
		rockchip,codec = <&hdmi1>;
		rockchip,jack-det;
	};
};

&hdmi0 {
	status = "okay";
};

&hdmi0_in {
	hdmi0_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi0>;
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&hdmi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim0_tx1_cec &hdmim0_tx1_hpd
			     &hdmim1_tx1_scl &hdmim1_tx1_sda>;
	status = "okay";
};

&hdmi1_in {
	hdmi1_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_hdmi1>;
	};
};

&hdmi1_out {
	hdmi1_out_con: endpoint {
		remote-endpoint = <&hdmi1_con_in>;
	};
};

&hdptxphy0 {
	status = "okay";
};

&hdptxphy1 {
	status = "okay";
};

&i2s5_8ch {
	status = "okay";
};

&i2s6_8ch {
	status = "okay";
};

&led_blue_pwm {
	pwms = <&pwm4 0 25000 0>;
};

&led_green_pwm {
	pwms = <&pwm5 0 25000 0>;
};

&pinctrl {


	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	usb {
		usb_otg_pwren: usb-otg-pwren {
			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	/* RTS (PC2) is owned by &uart7 via uart7m0_rtsn; do not define uart7_gpios here or wireless-bluetooth's default pinctrl would claim PC2 and conflict. */
	wireless-bluetooth {
		bt_reset_gpio: bt-reset-gpio {
			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <4 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio: bt-irq-gpio {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

&vp0 {
	vp0_out_hdmi0: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi0_in_vp0>;
	};
};

&vp1 {
	vp1_out_hdmi1: endpoint@ROCKCHIP_VOP2_EP_HDMI1 {
		reg = <ROCKCHIP_VOP2_EP_HDMI1>;
		remote-endpoint = <&hdmi1_in_vp1>;
	};
};

&sdio {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sdiom0_pins>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	max-frequency = <150000000>;
	sd-uhs-sdr104;
	mmc-pwrseq = <&sdio_pwrseq>;
};

/* AP6611 Bluetooth over UART7 (hci_bcm/btbcm); WiFi remains on SDIO above.
 * UART pins (from rk3588-extra-pinctrl.dtsi):
 *   TX  = uart7m0_xfer  → GPIO2 PB5 (host out)
 *   RX  = uart7m0_xfer  → GPIO2 PB4 (host in)
 *   RTS = uart7m0_rtsn  → GPIO4 PC2 (host out)
 *   CTS = uart7m0_ctsn  → GPIO4 PC6 (host in, schematic GPIO4_C6)
 */
&uart7 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart7m0_xfer &uart7m0_rtsn &uart7m0_ctsn>;

	/* Reference DTBs (dtb-5.10 / dtb-6.1) have no serdev BT node and no BT baud; only fiq-debugger has rockchip,baudrate (1.5M). 3M is standard BCM UART operational rate. */
	bluetooth {
		compatible = "brcm,bcm4345c5";
		clocks = <&hym8563>;
		clock-names = "txco";
		max-speed = <3000000>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA0 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wakeup";
		device-wakeup-gpios = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>; /* BT_WAKE (host→device: keep awake) */
		shutdown-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;     /* BT_RST_N (power on + release reset when high) */
		pinctrl-names = "default";
		pinctrl-0 = <&bt_reset_gpio &bt_wake_gpio &bt_irq_gpio>;
		/* interrupts = BT_HOST_WAKE (device→host: wake host) on PA0 */
		status = "okay";
	};
};
